# App
APP_NAME="Prism Workbench"
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./prism.db

# LLM
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=prism-workbench
KEYCLOAK_CLIENT_ID=prism-workbench
KEYCLOAK_CLIENT_SECRET=

# Demo mode (local only)
DEMO_MODE=false
